generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Product {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(100)
  price     Decimal  @db.Decimal(10,2)
  stock     Int      @db.Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}