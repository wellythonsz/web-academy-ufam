<h2>Editar Produto (ID: {{product.id}})</h2>
<hr>

<form action="/product/update/{{product.id}}" method="POST" class="mt-4">
    <div class="mb-3">
        <label for="name" class="form-label">Nome do Produto</label>
        <input type="text" name="name" id="name" class="form-control" value="{{product.name}}" required>
    </div>
    
    <div class="mb-3">
        <label for="price" class="form-label">Preço</label>
        <input type="number" step="0.01" name="price" id="price" class="form-control" value="{{product.price}}" required>
    </div>
    
    <button type="submit" class="btn btn-primary">Atualizar Produto</button>
    <a href="/product" class="btn btn-secondary">Cancelar</a>
</form>