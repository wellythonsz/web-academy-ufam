<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lista de Produtos</h2>
    <a href="/product/create" class="btn btn-primary">Novo Produto</a>
</div>

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Preço (R$)</th>
            <th class="text-center">Ações</th>
        </tr>
    </thead>
    <tbody>
        {{#each products}}
        <tr>
            <td>{{this.id}}</td>
            <td>{{this.name}}</td>
            <td>{{this.price}}</td>
            <td class="text-center">
                <a href="/product/update/{{this.id}}" class="btn btn-sm btn-warning">Editar</a>
                <form action="/product/delete/{{this.id}}" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                </form>
            </td>
        </tr>
        {{else}}
        <tr>
            <td colspan="4" class="text-center">Nenhum produto cadastrado.</td>
        </tr>
        {{/each}}
    </tbody>
</table>